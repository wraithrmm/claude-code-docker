{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:*)",
      "LS(/workspace/project/ai-playground)",
      "LS(/workspace/project/ai-playground/**)",
      "Read(/workspace/project/ai-playground/**)",
      "Write(/workspace/project/ai-playground/**)",
      "Edit(/workspace/project/ai-playground/**)",
      "MultiEdit(/workspace/project/ai-playground/**)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/init-playground:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/list-projects:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/continue-project:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/create-project:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/verify-project:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/count-projects:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/create-task:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/list-tasks:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/move-task:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/create-project-task:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/list-project-tasks:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/move-project-task:*)",
      "Bash(/opt/claude-plugins/current/plugins/workflow/scripts/git-diff.sh:*)",
      "Bash(/workspace/.claude/bin/run-linters:*)",
      "Bash(/workspace/.claude/bin/run-tests:*)",
      "Bash(.claude/bin/run-linters:*)",
      "Bash(.claude/bin/run-tests:*)",
      "Bash(npx playwright:*)",
      "Bash(npx @playwright/test:*)",
      "Bash(playwright:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env*)",
      "Read(**/dotenv)",
      "Read(**/*dotenv)",
      "Read(**/env)",
      "Read(**/*sites*.ini*)"
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "tmux"
}
